{
    "models": [
        {
            "classname": "Customer",
            "code": "class Customer(Base):\n    __tablename__ = 'customer'\n\n    Id = Column(Integer, primary_key=True)\n    Name = Column(String)\n    CreditLimit = Column(DECIMAL)\n    Balance = Column(DECIMAL, default=decimal.Decimal(0))",
            "description": "Customer with balance and credit limit",
            "name": "Customer"
        },
        {
            "classname": "Order",
            "code": "class Order(Base):\n    __tablename__ = 'order'\n\n    Id = Column(Integer, primary_key=True)\n    CustomerId = Column(ForeignKey('customer.Id'))\n    DateShipped = Column(DateTime)\n    AmountTotal = Column(DECIMAL, default=decimal.Decimal(0))\n    Notes = Column(String)",
            "description": "Orders that belongs to a customer and includes total amount and shipment date",
            "name": "Order"
        },
        {
            "classname": "Item",
            "code": "class Item(Base):\n    __tablename__ = 'item'\n\n    Id = Column(Integer, primary_key=True)\n    OrderId = Column(ForeignKey('order.Id'))\n    Quantity = Column(Integer)\n    UnitPrice = Column(DECIMAL)\n    Amount = Column(DECIMAL, default=decimal.Decimal(0))",
            "description": "Items with quantity, unit price, and total amount",
            "name": "Item"
        },
        {
            "classname": "Product",
            "code": "class Product(Base):\n    __tablename__ = 'product'\n\n    Id = Column(Integer, primary_key=True)\n    Name = Column(String)\n    UnitPrice = Column(DECIMAL)",
            "description": "Products with name and unit price",
            "name": "Product"
        }
    ],
    "rules": [
        {
            "name": "CustomerBalanceCreditLimitConstraint",
            "description": "Ensure customer balance does not exceed the credit limit",
            "use_case": "Check Credit",
            "entity": "Customer",
            "code": "Rule.constraint(validate=Customer,\n                as_condition=lambda row: row.Balance <= row.CreditLimit,\n                error_msg=\"Customer balance ({row.Balance}) exceeds credit limit ({row.CreditLimit})\")"
        },
        {
            "name": "CustomerBalanceSumOrders",
            "description": "Customer balance is sum of their orders where date_shipped is null",
            "use_case": "Check Credit",
            "entity": "Customer",
            "code": "Rule.sum(derive=Customer.Balance, as_sum_of=Order.AmountTotal, where=lambda row: row.DateShipped is None)"
        },
        {
            "name": "OrderAmountTotalSumItems",
            "description": "Order amount total is sum of item amounts",
            "use_case": "Check Credit",
            "entity": "Order",
            "code": "Rule.sum(derive=Order.AmountTotal, as_sum_of=Item.Amount)"
        },
        {
            "name": "ItemAmountProductQuantity",
            "description": "Item amount is quantity multiplied by unit price",
            "use_case": "Check Credit",
            "entity": "Item",
            "code": "Rule.formula(derive=Item.Amount, as_expression=lambda row: row.Quantity * row.UnitPrice)"
        },
        {
            "name": "ItemUnitPriceCopyProduct",
            "description": "Item unit price copied from Product unit price",
            "use_case": "Check Credit",
            "entity": "Item",
            "code": "Rule.copy(derive=Item.UnitPrice, from_parent=Product.UnitPrice)"
        },
        {
            "name": "OrderSendKafkaShipping",
            "description": "Send order to Kafka topic 'order_shipping' if date_shipped is not None",
            "use_case": "App Integration",
            "entity": "Order",
            "code": "Rule.after_flush_row_event(on_class=Order, calling=kafka_producer.send_row_to_kafka,\n                           if_condition=lambda row: row.DateShipped is not None,\n                           with_args={\"topic\": \"order_shipping\"})"
        }
    ],
