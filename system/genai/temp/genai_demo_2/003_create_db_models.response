{
    "models": [
        {
            "classname": "Customer",
            "code": "class Customer(Base):\n    __tablename__ = 'customer'\n\n    id = Column(Integer, primary_key=True)\n    name = Column(String(100))\n    credit_limit = Column(DECIMAL, nullable=False)\n    balance = Column(DECIMAL)\n",
            "description": "Customer table storing customer information.",
            "name": "Customer"
        },
        {
            "classname": "Order",
            "code": "class Order(Base):\n    __tablename__ = 'order'\n\n    id = Column(Integer, primary_key=True)\n    customer_id = Column(Integer, ForeignKey('customer.id'))\n    date_shipped = Column(DateTime)\n    notes = Column(String(200))\n    amount_total = Column(DECIMAL)\n",
            "description": "Order table containing the customer orders.",
            "name": "Order"
        },
        {
            "classname": "Item",
            "code": "class Item(Base):\n    __tablename__ = 'item'\n\n    id = Column(Integer, primary_key=True)\n    order_id = Column(Integer, ForeignKey('order.id'))\n    product_id = Column(Integer, ForeignKey('product.id'))\n    quantity = Column(Integer, nullable=False)\n    unit_price = Column(DECIMAL)\n    amount = Column(DECIMAL)\n",
            "description": "Item table linking products with orders. Each item has price, quantity, and derived amount.",
            "name": "Item"
        },
        {
            "classname": "Product",
            "code": "class Product(Base):\n    __tablename__ = 'product'\n\n    id = Column(Integer, primary_key=True)\n    name = Column(String(100))\n    unit_price = Column(DECIMAL, nullable=False)\n",
            "description": "Product table storing product details.",
            "name": "Product"
        }
    ],
    "rules": [
        {
            "name": "Customer Balance Constraint",
            "description": "The Customer's balance must be less than their credit limit.",
            "use_case": "Check Credit",
            "entity": "Customer",
            "code": "Rule.constraint(validate=Customer,\n                as_condition=lambda row: row.balance <= row.credit_limit,\n                error_msg=\"Customer's balance ({row.balance}) exceeds the credit limit ({row.credit_limit})\")"
        },
        {
            "name": "Customer Balance Derivation",
            "description": "Derives Customer's balance as sum of Order amount_total where date_shipped is null.",
            "use_case": "Check Credit",
            "entity": "Customer",
            "code": "Rule.sum(derive=Customer.balance, as_sum_of=Order.amount_total, where=lambda row: row.date_shipped is None)"
        },
        {
            "name": "Order Amount Total Derivation",
            "description": "Calculates Order's amount_total as sum of Item amounts.",
            "use_case": "Check Credit",
            "entity": "Order",
            "code": "Rule.sum(derive=Order.amount_total, as_sum_of=Item.amount)"
        },
        {
            "name": "Item Amount Formula",
            "description": "Computes Item.amount as product of quantity and unit_price.",
            "use_case": "Check Credit",
            "entity": "Item",
            "code": "Rule.formula(derive=Item.amount, as_expression=lambda row: row.quantity * row.unit_price)"
        },
        {
            "name": "Item Unit Price Copy",
            "description": "Copies Item's unit_price from Product's unit_price at creation time.",
            "use_case": "Check Credit",
            "entity": "Item",
            "code": "Rule.copy(derive=Item.unit_price, from_parent=Product.unit_price)"
        },
        {
            "name": "Order Kafka Event",
            "description": "Sends Order to Kafka topic 'order_shipping' upon non-null date_shipped.",
            "use_case": "App Integration",
            "entity": "Order",
            "code": "Rule.after_flush_row_event(on_class=Order, calling=kafka_producer.send_row_to_kafka,\n               if_condition=lambda row: row.date_shipped is not None,\n               with_args={\"topic\": \"order_shipping\"})"
        }
    ],
    "graphics": [],
