    "test_data_sqlite": "INSERT INTO customer (id, name, credit_limit, balance) VALUES (1, 'Alice Wonderland', '10000.00', '0.00');\nINSERT INTO customer (id, name, credit_limit, balance) VALUES (2, 'Bob Builder', '5000.00', '0.00');\nINSERT INTO customer (id, name, credit_limit, balance) VALUES (3, 'Charlie Chocolate', '2000.00', '0.00');\nINSERT INTO customer (id, name, credit_limit, balance) VALUES (4, 'Dora Explorer', '3000.00', '0.00');\n\nINSERT INTO order (id, customer_id, date_shipped, notes, amount_total) VALUES (1, 1, NULL, 'Urgent delivery', '0.00');\nINSERT INTO order (id, customer_id, date_shipped, notes, amount_total) VALUES (2, 2, '2023-01-15', 'Gift wrap', '0.00');\nINSERT INTO order (id, customer_id, date_shipped, notes, amount_total) VALUES (3, 3, NULL, 'No rush', '0.00');\nINSERT INTO order (id, customer_id, date_shipped, notes, amount_total) VALUES (4, 4, '2023-03-01', 'Handle with care', '0.00');\n\nINSERT INTO product (id, name, unit_price) VALUES (1, 'Widget', '199.99');\nINSERT INTO product (id, name, unit_price) VALUES (2, 'Gadget', '299.99');\nINSERT INTO product (id, name, unit_price) VALUES (3, 'Thingamajig', '99.99');\nINSERT INTO product (id, name, unit_price) VALUES (4, 'Doodad', '49.99');\n\nINSERT INTO item (id, order_id, product_id, quantity, unit_price, amount) VALUES (1, 1, 1, 2, '199.99', '399.98');\nINSERT INTO item (id, order_id, product_id, quantity, unit_price, amount) VALUES (2, 2, 2, 1, '299.99', '299.99');\nINSERT INTO item (id, order_id, product_id, quantity, unit_price, amount) VALUES (3, 3, 3, 5, '99.99', '499.95');\nINSERT INTO item (id, order_id, product_id, quantity, unit_price, amount) VALUES (4, 4, 4, 3, '49.99', '149.97');",
